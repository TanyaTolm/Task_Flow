<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/calendarFragment">

    <fragment
        android:id="@+id/foldersFragment"
        android:name="com.example.task_flow.ui.main.FoldersFragment"
        android:label="Папки"
        tools:layout="@layout/fragment_folders" />

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.task_flow.ui.main.CalendarFragment"
        android:label="Календарь"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.task_flow.ui.main.ProfileFragment"
        android:label="Профиль"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/createTaskFragment"
        android:name="com.example.task_flow.ui.main.CreateTaskFragment"
        android:label="Создание задачи"
        tools:layout="@layout/fragment_create_task" />

    <fragment
        android:id="@+id/taskDetailFragment"
        android:name="com.example.task_flow.ui.main.TaskDetailFragment"
        android:label="Просмотр задачи"
        tools:layout="@layout/fragment_task_detail" />

    <fragment
        android:id="@+id/createFolderFragment"
        android:name="com.example.task_flow.ui.main.CreateFolderFragment"
        android:label="Создание папки"
        tools:layout="@layout/fragment_create_folder" />

    <fragment
        android:id="@+id/folderDetailFragment"
        android:name="com.example.task_flow.ui.main.FolderDetailFragment"
        android:label="Просмотр папки"
        tools:layout="@layout/fragment_folder_detail" />

</navigation>